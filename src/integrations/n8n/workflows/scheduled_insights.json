    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst agg = data.aggregations || {};\nconst habits = data.habits || [];\nconst suggestions = data.suggestions || [];\n\nlet msg = `📊 *Financial Digest*\\n`;\nmsg += `${data.date_from} → ${data.date_to}\\n\\n`;\n\n// Top spending categories\nconst breakdown = agg.receipt_line_breakdown || [];\nif (breakdown.length) {\n  msg += `*Top Spending:*\\n`;\n  breakdown.slice(0, 5).forEach(item => {\n    msg += `  • ${item.description}: $${item.total.toFixed(0)}\\n`;\n  });\n  msg += `\\n`;\n}\n\n// Habits\nif (habits.length) {\n  msg += `*Habits:*\\n`;\n  habits.forEach(h => {\n    const icon = h.severity === 'warning' ? '⚠️' : 'ℹ️';\n    msg += `  ${icon} ${h.observation}\\n`;\n  });\n  msg += `\\n`;\n}\n\n// Suggestions\nif (suggestions.length) {\n  msg += `*Suggestions:*\\n`;\n  suggestions.forEach(s => {\n    msg += `  💡 *${s.title}*: ${s.body}\\n`;\n  });\n}\n\nreturn [{ json: { text: msg } }];"
      },
