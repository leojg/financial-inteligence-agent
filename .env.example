# Required: OpenAI API key (used by reconciliation and insights agents)
#OPENAI_API_KEY=sk-...

# Required for currency conversion: exchangerate.host API key
#EXCHANGE_RATE_API_KEY=...

# SQLite DB used for LangGraph checkpointing and app caches (exchange rates, normalized docs, insights).
# Defaults to data/agent.db if unset.
#FINANCE_AGENT_DB_PATH=./data/agent.db

# Optional: LangSmith tracing
#LANGSMITH_API_KEY=...
#LANGSMITH_PROJECT=finance-intelligence-agent
