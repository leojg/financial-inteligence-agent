# Required: OpenAI API key (used by reconciliation and insights agents)
#OPENAI_API_KEY=sk-...

# Required for currency conversion: exchangerate.host API key
#EXCHANGE_RATE_API_KEY=...

# Database URL for SQLAlchemy. Supports SQLite (default) and PostgreSQL.
# Defaults to sqlite:///data/agent.db if unset.
#DATABASE_URL=sqlite:///data/agent.db
#DATABASE_URL=postgresql://user:pass@localhost/finance_agent

# Optional: LangSmith tracing
#LANGSMITH_API_KEY=...
#LANGSMITH_PROJECT=finance-intelligence-agent

# ─── n8n integration (scheduled_insights, email→reconcile, chat workflows) ─────
# Telegram bot token (create bot via @BotFather); injected into n8n credential store
#N8N_TELEGRAM_BOT_TOKEN=
# Telegram chat ID for sending digest notifications (get chat ID from @userinfobot)
#N8N_TELEGRAM_CHAT_ID=
# Financial API base URL (default: http://api:8000 when using Docker Compose)
#FINANCIAL_API_URL=http://api:8000

# Webhook URL for n8n
#WEBHOOK_URL=http://localhost:5678/

# ── ngrok tunnel (dev only) ────────────────────────────────────────
# ngrok authtoken for secure tunnels to n8n
#NGROK_AUTHTOKEN=...