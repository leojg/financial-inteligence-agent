# Required: OpenAI API key (used by reconciliation and insights agents)
#OPENAI_API_KEY=sk-...

# Required for currency conversion: exchangerate.host API key
#EXCHANGE_RATE_API_KEY=...

# Database URL for SQLAlchemy. Supports SQLite (default) and PostgreSQL.
# Defaults to sqlite:///data/agent.db if unset.
#DATABASE_URL=sqlite:///data/agent.db
#DATABASE_URL=postgresql://user:pass@localhost/finance_agent

# Optional: LangSmith tracing
#LANGSMITH_API_KEY=...
#LANGSMITH_PROJECT=finance-intelligence-agent
